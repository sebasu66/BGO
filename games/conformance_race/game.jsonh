{
  "schema": "bgo.game",
  "game": {
    "id": "conformance_race",
    "name": "BGO Conformance Race",
    "min_players": 2,
    "max_players": 2,
    "turn_based": true
  },
  "flow": {
    "initial_phase": "main",
    "turn_order": "round_robin",
    "turn_end": "manual"
  },
  "listeners": [],
  "board": {
    "component": "bgo.board.checkered",
    "config": {
      "columns": 3,
      "rows": 2,
      "cell_size": 1.0
    }
  },
  "players": [
    {"id": "player_1", "name": "Player 1"},
    {"id": "player_2", "name": "Player 2"}
  ],
  "setup": {
    "objects": [
      {
        "id": "player_1_piece",
        "component": "bgo.piece.basic_cylinder",
        "owner_id": "player_1",
        "quantity": 1,
        "config": {"color_source": "fixed", "color": "#ffffff"},
        "initial_location": {"type": "slot", "slot_id": "board:0:0"}
      },
      {
        "id": "player_2_piece",
        "component": "bgo.piece.basic_cylinder",
        "owner_id": "player_2",
        "quantity": 1,
        "config": {"color_source": "fixed", "color": "#999999"},
        "initial_location": {"type": "slot", "slot_id": "board:0:1"}
      }
    ]
  },
  "conformance": {
    "commands": [
      {"verb": "object.move", "actor_id": "player_1", "target_id": "player_1_piece", "args": {"slot_id": "board:1:0"}},
      {"verb": "turn.end", "actor_id": "player_1"},
      {"verb": "object.move", "actor_id": "player_2", "target_id": "player_2_piece", "args": {"slot_id": "board:1:1"}},
      {"verb": "turn.end", "actor_id": "player_2"},
      {"verb": "object.move", "actor_id": "player_1", "target_id": "player_1_piece", "args": {"slot_id": "board:2:0"}},
      {"verb": "match.finish", "actor_id": "player_1", "args": {"outcome": "victory", "winner_participant_ids": ["player_1"]}}
    ]
  }
}
