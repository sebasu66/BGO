{
  "schema": "bgo.game",
  "game": {
    "id": "test001",
    "name": "BGO Component Test",
    "min_players": 2,
    "max_players": 2,
    "turn_based": true
  },
  "flow": {
    "initial_phase": "main",
    "turn_order": "round_robin",
    "turn_end": "manual"
  },
  "listeners": [],
  "table": {
    "width": 15.5,
    "depth": 9.8,
    "environment": {
      "preset": "studio",
      "background_color": "#C7BFB0",
      "lighting": "soft_grid"
    },
    "surface": {
      "material": "wood",
      "placement_mode": "free_or_slot"
    },
    "areas": [
      {
        "id": "board_area",
        "bounds": { "center": { "x": 0, "z": 0 }, "size": { "x": 10.2, "z": 7.8 } },
        "placement_mode": "free_or_slot",
        "slots": [
          {
            "id": "main_board",
            "capacity": 1,
            "accepted_kinds": ["board"],
            "pose": {
              "position": { "x": 0, "y": 0, "z": 0 },
              "rotation": { "x": 0, "y": 0, "z": 0 }
            }
          }
        ]
      },
      {
        "id": "player_1_area",
        "bounds": { "center": { "x": -6.15, "z": 0 }, "size": { "x": 1.55, "z": 7.2 } },
        "placement_mode": "free_or_slot",
        "owner_id": "player_1"
      },
      {
        "id": "player_2_area",
        "bounds": { "center": { "x": 6.15, "z": 0 }, "size": { "x": 1.55, "z": 7.2 } },
        "placement_mode": "free_or_slot",
        "owner_id": "player_2"
      }
    ]
  },
  "board": {
    "component": "bgo.board.checkered",
    "config": {
      "columns": 8,
      "rows": 6,
      "cell_size": 1.2
    }
  },
  "players": [
    {
      "id": "player_1",
      "name": "Player 1",
      "color": "#F2B837",
      "presence": {
        "component": "bgo.player_presence.basic_mask",
        "config": {}
      },
      "area": {
        "component": "bgo.player_area.basic",
        "config": { "visible": true, "public_objects": true }
      },
      "hand": {
        "visibility": "owner_face_others_hidden"
      }
    },
    {
      "id": "player_2",
      "name": "Player 2",
      "color": "#4DB7F2",
      "presence": {
        "component": "bgo.player_presence.basic_mask",
        "config": {}
      },
      "area": {
        "component": "bgo.player_area.basic",
        "config": { "visible": true, "public_objects": true }
      },
      "hand": {
        "visibility": "owner_face_others_hidden"
      }
    }
  ],
  "setup": {
    "objects": [
      {
        "id": "player_1_piece",
        "component": "bgo.piece.basic_cylinder",
        "owner_id": "player_1",
        "quantity": 1,
        "config": { "color_source": "player" },
        "initial_location": { "type": "slot", "slot_id": "board:1:2" }
      },
      {
        "id": "player_2_stack",
        "component": "bgo.piece.basic_cylinder",
        "owner_id": "player_2",
        "quantity": 3,
        "config": { "color_source": "player" },
        "initial_location": { "type": "slot", "slot_id": "board:6:3" }
      },
      {
        "id": "neutral_stack",
        "component": "bgo.piece.basic_cylinder",
        "owner_id": "",
        "quantity": 5,
        "config": { "color_source": "fixed", "color": "#E7E0CF" },
        "initial_location": { "type": "slot", "slot_id": "board:3:2" }
      }
    ]
  }
}
