; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="BGO"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"
GodotxToast="*uid://bgvixrj72u7rv"
GdssRuntime="*uid://yu6lhnx763yp"
Console="*uid://ouiu5xh1cs8n"
BgoGameCommandConsole="*res://src/debug/bgo_game_command_console.gd"

[debug]

file_logging/enable_file_logging=true
file_logging/log_path="user://logs/bgo.log"
file_logging/max_log_files=10

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=2
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[editor_plugins]

enabled=PackedStringArray("res://addons/asset_placer/plugin.cfg", "res://addons/console/plugin.cfg", "res://addons/gdss/plugin.cfg", "res://addons/godot_ai/plugin.cfg", "res://addons/godotx_toast/plugin.cfg", "res://addons/lente/plugin.cfg", "res://addons/lucide/plugin.cfg", "res://addons/reactive_ui/plugin.cfg", "res://addons/reactive_ui_editor/plugin.cfg", "res://addons/spark/plugin.cfg")

[gdss]

internal/initialized=true
editor/use_minimap=true
editor/show_outline=true

