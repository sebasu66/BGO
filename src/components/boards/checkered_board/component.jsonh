    "grid_points_per_unit": { "type": "int", "min": 1, "max": 100, "default": 5 },
    "grid_virtual_infinite": { "type": "bool", "default": true },
    "slots_enabled": { "type": "bool", "default": true }
  },
  "capabilities": ["slot_grid", "placeable_surface"]
}
